# Copy to `.env` and fill in. `.env` is gitignored - never commit a real key.
# Loaded automatically on `import starter`; a variable already exported in the
# shell always wins over this file.

# --- Optional Phase 6 LLM reranking (the agent is fully offline without it) ---
# off (default) | shadow (price the calls only) | rerank (apply the ordering)
TECHJAM_PHASE6_MODE=off

# nvidia = free hosted NIM at build.nvidia.com, stdlib HTTP, no package needed.
# anthropic = claude-opus-5, needs `pip install anthropic` and ANTHROPIC_API_KEY.
TECHJAM_LLM_PROVIDER=nvidia

# Get one at https://build.nvidia.com (starts with `nvapi-`).
NVIDIA_API_KEY=

# Provider defaults; uncomment only to override.
# TECHJAM_LLM_MODEL=openai/gpt-oss-120b
# TECHJAM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# TECHJAM_LLM_KEY_VARIABLE=NVIDIA_API_KEY

# Call budget and pacing. MIN_INTERVAL spaces requests out when the free tier's
# requests-per-minute cap starts returning 429s.
# TECHJAM_LLM_SHORTLIST=40
# TECHJAM_LLM_MAX_CALLS=3
# TECHJAM_LLM_FIRST_TURN=1
# TECHJAM_LLM_LAST_TURN=8
# TECHJAM_LLM_TIMEOUT=12
# TECHJAM_LLM_MAX_RETRIES=1
# TECHJAM_LLM_MAX_TOKENS=2048
# TECHJAM_LLM_EFFORT=low
# TECHJAM_LLM_MIN_INTERVAL=0

# --- Deterministic runtime overrides (see docs/REPO_OVERVIEW.md) ---
# TECHJAM_PHASE4_MODE=ask
# TECHJAM_PHASE5_MODE=trace
# TECHJAM_FACET_WEIGHT=0.95
# TECHJAM_RRF_K=60
